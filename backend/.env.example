# Copy to .env and fill in. OpenAI-compatible endpoint (works for Qwen/DashScope, GLM/Zhipu, local vLLM, OpenAI).

# --- Student ensemble: small, fast, cheap model (keeps the delta sensitive) ---
STUDENT_BASE_URL=https://api.openai.com/v1
STUDENT_API_KEY=sk-...
STUDENT_MODEL=gpt-4o-mini

# --- Question generation + attribution: stronger model ---
GENERATOR_BASE_URL=https://api.openai.com/v1
GENERATOR_API_KEY=sk-...
GENERATOR_MODEL=gpt-4o

# --- Concurrency for the ensemble fan-out ---
MAX_CONCURRENCY=40
