# Copy to .env and fill in. Never expose these values through Vite or commit .env.

# --- Student ensemble: small, fast, cheap model (keeps the delta sensitive) ---
STUDENT_BASE_URL=https://api.deepseek.com
STUDENT_API_KEY=YOUR_DEEPSEEK_KEY
STUDENT_MODEL=deepseek-v4-flash

# --- Question generation + attribution: stronger model ---
GENERATOR_BASE_URL=https://api.deepseek.com
GENERATOR_API_KEY=YOUR_DEEPSEEK_KEY
GENERATOR_MODEL=deepseek-v4-pro
VERIFIER_MODEL=deepseek-v4-pro

# --- Concurrency for the ensemble fan-out ---
MAX_CONCURRENCY=40

# --- Measurement ensemble size (3 taught + 2 cold = 5 total; fast demo mode) ---
N_TAUGHT=3
N_COLD=2

# --- /measure speed knobs (the cold-student filter dominates /measure time) ---
FILTER_COLD_SAMPLES=2
N_CANDIDATE_QUESTIONS=8

# --- Real-time question gate: ask only when a chunk is confused
#     (confidence below this threshold OR a hesitation marker; anomalies optional) ---
QUESTION_CONFIDENCE_THRESHOLD=0.5
QUESTION_GATE_ON_ANOMALIES=false

# --- Confusion ml-service (HyperAI GPU box). Audio path; falls back to neutral on failure. ---
ML_SERVICE_URL=http://localhost:8100
ML_SERVICE_TIMEOUT=5

# Comma-separated browser origins allowed to call this API.
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# --- Context store: "memory" (lost on restart) or "db" (Postgres, durable) ---
# Recommended for dev: run ONLY the database in Docker and keep the backend local with --reload,
#   docker compose up -d db
# Plans, generated teacher's notes, cross-class memory and objective progress then survive a
# restart — with "memory" every class is regenerated (and re-billed) after each reload.
STORE_BACKEND=db
# Used only when STORE_BACKEND=db. docker-compose sets this itself for the backend container.
DATABASE_URL=postgresql+asyncpg://ts:ts@localhost:5432/teachable

# How many new utterances to accumulate before checking which class objectives they covered.
# One verifier call per check — lower is more responsive, higher is cheaper.
OBJECTIVE_CHECK_EVERY=3
